<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>

    <PackageId>RediensIAM.Client</PackageId>
    <Version>0.6.0</Version>
    <Description>Resource-server client for RediensIAM: live token introspection (RFC 7662) and permission checks, plus an ASP.NET Core authentication handler.</Description>
    <PackageTags>iam;oauth2;oidc;authentication;authorization</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <!-- Supplies IMemoryCache and IHttpClientFactory alongside the authentication handler's
         ASP.NET Core types. Referencing Microsoft.Extensions.Caching.Memory and
         Microsoft.Extensions.Http separately duplicated what the shared framework already
         carries — that duplication was NU1510. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>

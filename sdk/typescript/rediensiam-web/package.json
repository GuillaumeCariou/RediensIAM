{
  "name": "rediensiam-web",
  "version": "0.2.0",
  "description": "Browser SDK for RediensIAM: OIDC authorization-code + PKCE login, in-memory tokens, authenticated fetch. Zero dependencies.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test src/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": ["iam", "oauth2", "oidc", "pkce", "authentication"],
  "license": "MIT",
  "devDependencies": { "typescript": "^5.6.0" }
}
